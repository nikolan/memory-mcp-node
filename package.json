{
  "name": "local-memory-mcp",
  "version": "1.0.1",
  "description": "Local file-based memory for AI assistants via MCP",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "local-memory-mcp": "dist/index.js",
    "local-memory-mcp-maintenance": "dist/maintenance.js"
  },
  "files": [
    "dist",
    "config.json",
    ".env.example"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test",
    "dev": "tsc --watch",
    "init": "pnpm build && node dist/init.js",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build",
    "release:patch": "pnpm version patch && pnpm publish",
    "release:minor": "pnpm version minor && pnpm publish",
    "release:major": "pnpm version major && pnpm publish"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "claude",
    "vector-search"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "openai": "^4.28.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.4.1",
    "sqlite-vec": "^0.1.6",
    "tiktoken": "^1.0.18",
    "voyageai": "^0.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "esbuild",
      "protobufjs"
    ]
  }
}